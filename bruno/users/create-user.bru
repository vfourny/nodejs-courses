meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/users
  body: json
  auth: none
}

body:json {
  {
    "name": "John Doe",
    "email": "john@example.com"
  }
}

script:pre-request {
  req.setBody({
    name: 'User ' + Date.now(),
    email: `user${Date.now()}@example.com`,
  })
  
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar('userId', res.body.id)
  }
  
}
